    {"id": "ent.child_restraint", "type": "Entity", "canonical_key": "suitable_child_restraint", "name": "Thiết bị an toàn phù hợp cho trẻ em", "kind": "equipment", "identity_scope": "VN.36_2024_QH15.original", "aliases": []},
    {
      "id": "rule.seat.v1.s1", "type": "Rule", "rule_key": "VN.36_2024.D10K3.seat", "version": 1,
