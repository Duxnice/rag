      "bindings": [{"var": "driver", "entity_id": "ent.driver", "role": "actor"}, {"var": "child", "entity_id": "ent.child", "role": "beneficiary"}, {"var": "car", "entity_id": "ent.car", "role": "vehicle"}],
      "action": {"predicate": "seat_child_in_driver_row", "arguments": {"actor": "driver", "child": "child", "vehicle": "car"}},
      "condition": {"op": "all", "args": [
        {"op": "predicate", "fact": "child.age_years", "cmp": "lt", "value": 10, "unit": "year"},
        {"op": "predicate", "fact": "child.height_m", "cmp": "lt", "value": 1.35, "unit": "m"},
        {"op": "predicate", "fact": "car.carrying_child", "cmp": "eq", "value": true, "unit": "boolean"}
      ]},
