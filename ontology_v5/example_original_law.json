    {"id": "chunk.d10k3.original", "type": "Chunk", "provision_id": "p.article10.clause3", "text": "3. Khi chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô không được cho trẻ em ngồi cùng hàng ghế với người lái xe, trừ loại xe ô tô chỉ có một hàng ghế; người lái xe phải sử dụng, hướng dẫn sử dụng thiết bị an toàn phù hợp cho trẻ em.", "text_sha256": "a40cc9fcbd6c2d776a856c4a5ff45cf42ca6e0b3194ff879f5f1aa08322664fe", "source_locator": "supplied PDF, page 7, Article 10(3)", "source_revision": "pdf.original.whitespace_v1", "ordinal": 0},
    {"id": "chunk.d88k2.original", "type": "Chunk", "provision_id": "p.article88.clause2", "text": "2. Khoản 3 Điều 10 của Luật này có hiệu lực thi hành từ ngày 01 tháng 01 năm 2026.", "text_sha256": "7bd3945455112ef09c79eab330c46657dfd138ad545793b9ebe2ba3b499c2a08", "source_locator": "supplied PDF, page 55, Article 88(2)", "source_revision": "pdf.original.whitespace_v1", "ordinal": 0},
    {"id": "ent.driver", "type": "Entity", "canonical_key": "driver", "name": "Người lái xe", "kind": "person_category", "identity_scope": "VN.36_2024_QH15.original", "aliases": []},
