{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legal-rag:graph:5.0",
  "title": "Legal RAG V5.0 graph exchange contract",
  "description": "Design proposal, not a complete legal corpus. Cross-record validation also requires validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "coverage_note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "enum": [
            "original_law_example",
            "synthetic_test",
            "curated_corpus"
          ]
        },
        "coverage_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Document"
          },
          {
            "$ref": "#/$defs/Provision"
          },
          {
            "$ref": "#/$defs/Chunk"
          },
          {
            "$ref": "#/$defs/Rule"
          },
          {
            "$ref": "#/$defs/Entity"
          },
          {
            "$ref": "#/$defs/Change"
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "nullableDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "nullableTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "audit": {
      "type": "object",
      "required": [
        "recorded_from",
        "recorded_to",
        "review_status",
        "evidence"
      ],
      "properties": {
        "recorded_from": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_to": {
          "$ref": "#/$defs/nullableTime"
        },
        "review_status": {
          "enum": [
            "pending_review",
            "verified",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extraction_run_id": {
          "$ref": "#/$defs/id"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "start",
        "end",
        "quote",
        "purpose"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "content",
            "temporal",
            "identity"
          ]
        }
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "valid_from",
        "valid_to"
      ],
      "properties": {
        "valid_from": {
          "$ref": "#/$defs/nullableDate"
        },
        "valid_to": {
          "$ref": "#/$defs/nullableDate"
        }
      }
    },
    "Document": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "document_key",
        "title",
        "document_kind",
        "issued_on",
        "jurisdiction",
        "source_uri",
        "source_sha256",
        "coverage_through"
      ],
      "properties": {
        "type": {
          "const": "Document"
        },
        "document_key": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "document_kind": {
          "enum": [
            "law",
            "decree",
            "circular",
            "resolution",
            "decision",
            "consolidation",
            "other"
          ]
        },
        "issued_on": {
          "type": "string",
          "format": "date"
        },
        "default_effective_on": {
          "$ref": "#/$defs/nullableDate"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverage_through": {
          "$ref": "#/$defs/nullableDate"
        },
        "signed_by": {
          "type": "string",
          "minLength": 1
        },
        "issued_at_place": {
          "type": "string",
          "minLength": 1
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Provision": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "document_id",
        "parent_id",
        "level",
        "locator",
        "ordinal"
      ],
      "properties": {
        "type": {
          "const": "Provision"
        },
        "document_id": {
          "$ref": "#/$defs/id"
        },
        "parent_id": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "enum": [
            "preamble",
            "part",
            "chapter",
            "section",
            "article",
            "clause",
            "point",
            "annex"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "Chunk": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "provision_id",
        "text",
        "text_sha256",
        "source_locator",
        "source_revision",
        "ordinal"
      ],
      "properties": {
        "type": {
          "const": "Chunk"
        },
        "provision_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "context_text": {
          "type": "string"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "$ref": "#/$defs/id"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Entity": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "canonical_key",
        "name",
        "kind",
        "identity_scope",
        "aliases"
      ],
      "properties": {
        "type": {
          "const": "Entity"
        },
        "canonical_key": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "person_category",
            "organization",
            "vehicle_category",
            "infrastructure",
            "signal",
            "equipment",
            "legal_document_category",
            "event_category",
            "financial_concept",
            "environment",
            "other_concept"
          ]
        },
        "identity_scope": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "var",
        "entity_id",
        "role"
      ],
      "properties": {
        "var": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "entity_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "actor",
            "beneficiary",
            "authority",
            "vehicle",
            "object",
            "instrument",
            "location",
            "context"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate",
        "arguments"
      ],
      "properties": {
        "predicate": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "arguments": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "fact",
            "cmp",
            "value",
            "unit"
          ],
          "properties": {
            "op": {
              "const": "predicate"
            },
            "fact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            },
            "cmp": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte",
                "in"
              ]
            },
            "value": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "text"
          ],
          "properties": {
            "op": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "penalty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "unit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fine",
            "license_suspension",
            "warning",
            "confiscation",
            "license_points",
            "other"
          ]
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Rule": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/audit"
        },
        {
          "$ref": "#/$defs/validity"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "rule_key",
        "version",
        "provision_id",
        "kind",
        "modality",
        "summary",
        "bindings",
        "condition",
        "jurisdiction",
        "interpretation_scope"
      ],
      "properties": {
        "type": {
          "const": "Rule"
        },
        "rule_key": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "provision_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "norm",
            "definition",
            "mandate",
            "sanction",
            "exception",
            "transition",
            "procedure"
          ]
        },
        "modality": {
          "enum": [
            "obligated",
            "forbidden",
            "permitted",
            "none"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "condition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "penalties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/penalty"
          }
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "interpretation_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Change": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/audit"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "change_key",
        "provision_id",
        "operation",
        "effective_on",
        "scope_mode",
        "excluded_ids",
        "transition_rule_ids"
      ],
      "properties": {
        "type": {
          "const": "Change"
        },
        "change_key": {
          "$ref": "#/$defs/id"
        },
        "provision_id": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "enum": [
            "commence",
            "amend",
            "replace",
            "repeal",
            "suspend",
            "resume",
            "consolidate"
          ]
        },
        "effective_on": {
          "$ref": "#/$defs/nullableDate"
        },
        "ends_on": {
          "$ref": "#/$defs/nullableDate"
        },
        "scope_mode": {
          "enum": [
            "exact",
            "subtree"
          ]
        },
        "excluded_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "transition_rule_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "CONTAINS",
            "HAS_CHUNK",
            "HAS_RULE",
            "ISSUED_BY",
            "ARGUMENT",
            "DEFINES",
            "IS_A",
            "REFERENCES",
            "EXCEPTION_TO",
            "SANCTION_FOR",
            "HAS_CHANGE",
            "TARGETS",
            "REVISES"
          ]
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string"
        },
        "var": {
          "type": "string"
        },
        "change_id": {
          "$ref": "#/$defs/id"
        },
        "binding_map": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "scope_document_id": {
          "$ref": "#/$defs/id"
        },
        "valid_from": {
          "$ref": "#/$defs/nullableDate"
        },
        "valid_to": {
          "$ref": "#/$defs/nullableDate"
        },
        "recorded_from": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_to": {
          "$ref": "#/$defs/nullableTime"
        },
        "review_status": {
          "enum": [
            "pending_review",
            "verified",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}